@startuml
skinparam state {
  BackgroundColor #F1EFE8
  BorderColor #5F5E5A
  FontName Arial
}

[*] --> НетВыделения

state "Нет выделения" as НетВыделения {
  НетВыделения : Буфер обмена: частично активен
}

state "Слайд активен" as СлайдАктивен {
  СлайдАктивен : Макет, Раздел, Создать слайд — активны
}

state "Режим ввода текста" as РежимТекста {
  РежимТекста : Шрифт, Абзац — активны
  РежимТекста : Фигуры, Надпись — активны
}

state "Текст выделен" as ТекстВыделен {
  ТекстВыделен : Шрифт: Ж, К, Ч, размер, цвет — активны
  ТекстВыделен : Абзац: выравнивание, списки — активны
  ТекстВыделен : Копировать, Вырезать — активны
}

state "Фигура / объект выбран" as ФигураВыбрана {
  ФигураВыбрана : Расположение, Экспресс-стили — активны
  ФигураВыбрана : Фигуры: изменить фигуру — доступно
  ФигураВыбрана : Копировать, Вырезать — активны
}

state "Несколько объектов выделено" as НескольоОбъектов {
  НескольоОбъектов : Расположение: группировка — активна
  НескольоОбъектов : Шрифт, Абзац — частично доступны
}

state "Режим вставки фигуры" as РежимВставкиФигуры {
  РежимВставкиФигуры : Курсор — крест, ожидание рисования
  РежимВставки